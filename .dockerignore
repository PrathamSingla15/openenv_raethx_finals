# Local dev artifacts — don't ship in image
.venv/
venv/
.git/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
# Ship the full datasets/ tree EXCEPT the yfinance scratch cache:
# - datasets/catalog/sample-v2/  → episode manifests + sample bars (used by
#   write_sample_dataset and equal_weight_bnh_series)
# - datasets/real-data/real-v0/  → baked real OHLCV that _load_real_tier_data
#   needs (the new sample-v2 wheel requires this; sample-v0 wheels did not)
# - datasets/real-data/aliases.json → alias→ticker map sidecar
# Combined with the Dockerfile's ENV TRADEBENCH_DATASET_ROOT=/app/env/datasets,
# this lets resolve_settings() find the catalog directly without going through
# the broken _project_root() resolver in the installed wheel.
datasets/real-data/_yfinance_cache/
.idea/
.vscode/
.cursor/
*.swp
.DS_Store
.env

# ─────────────────────────────────────────────────────────────
# TradeBench environment configuration
# Copy to .env and fill in your values:  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Provider API keys (set the ones you plan to use) ────────

# OpenAI  (for --provider openai)
# OPENAI_API_KEY=sk-...

# Anthropic Claude  (for --provider claude)
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini  (for --provider gemini)
# GOOGLE_API_KEY=AI...

# ── Local model endpoint  (for --provider local) ───────────

# Base URL for any OpenAI-compatible local server (Ollama, LM Studio, vLLM)
# TRADEBENCH_LOCAL_BASE_URL=http://localhost:11434/v1
# TRADEBENCH_LOCAL_MODEL=llama3

# ── TradeBench paths ───────────────────────────────────────

# Override where datasets live (defaults to ./datasets with auto-bootstrap)
# TRADEBENCH_DATASET_ROOT=./datasets

# Override where run artifacts are written (defaults to ./artifacts)
# TRADEBENCH_ARTIFACT_ROOT=./artifacts

# ── Sandbox ────────────────────────────────────────────────

# Docker image for the agent sandbox (build with: docker build -f docker/sandbox.Dockerfile -t tradebench:latest .)
# TRADEBENCH_SANDBOX_IMAGE=tradebench:latest

# Sandbox provider: "docker" for real isolation, "local" for fast testing without Docker
# TRADEBENCH_SANDBOX_PROVIDER=local

# ── Coexistence with other local apps ─────────────────────
#
# TradeBench does not use your separate API (:8000), web app (:3000),
# Celery, Postgres, or Redis — it uses DuckDB, local files, and optionally
# Docker for the agent sandbox only.
#
# Default ports used here (override if they clash on your machine):
#   - OpenReward env server: 9090  (TRADEBENCH_SERVER_*)
#   - Web dashboard:          8501  (TRADEBENCH_DASHBOARD_*)

# ── OpenReward environment server ──────────────────────────

# Host and port for `tradebench server serve` (ORS / agent sessions)
# TRADEBENCH_SERVER_HOST=127.0.0.1
# TRADEBENCH_SERVER_PORT=9090

# ── Dashboard ──────────────────────────────────────────────

# Host and port for the local web dashboard
# TRADEBENCH_DASHBOARD_HOST=127.0.0.1
# TRADEBENCH_DASHBOARD_PORT=8501
